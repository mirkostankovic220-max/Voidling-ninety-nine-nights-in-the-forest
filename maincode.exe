-- StarterGui.VodlingGui.VoidlingMainFrame.ScrollingFrame.Bring.LocalScript
local function C_6()
local script = G2L["6"];
	local bringButton = script.Parent
	
	-- Path: BringButton -> ScrollingFrame -> Frame
	local mainFrame = bringButton.Parent.Parent
	
	-- Path: Frame -> ScreenGui (The root of the UI)
	local voidlingGui = mainFrame.Parent
	
	-- Access the VoidlingMainFrame and the Info text
	local voidlingMainFrame = voidlingGui:WaitForChild("VoidlingMainFrame")
	local textToHide = voidlingMainFrame:WaitForChild("Info")
	
	-- Reference the buttons you want to show
	local bringFuelButton = mainFrame:WaitForChild("Bring Fuel")
	local bringCoalButton = mainFrame:WaitForChild("Bring Coal")
	
	bringButton.MouseButton1Click:Connect(function()
		-- 1. Show the Fuel button
		bringFuelButton.Visible = true
	
		-- 2. Show the Coal button
		bringCoalButton.Visible = true
	
		-- 3. Hide the Info text
		textToHide.Visible = false
	end)
end;
task.spawn(C_6);
-- StarterGui.VodlingGui.VoidlingMainFrame.Bring Fuel.BringScript
local function C_d()
local script = G2L["d"];
	-- Get references to the button and player
	local button = script.Parent 
	local player = game.Players.LocalPlayer
	
	-- Function to handle the button click
	local function onButtonClicked()
		-- 1. Safety Check: Make sure the player character and root part exist
		local character = player.Character
		if not character or not character:FindFirstChild("HumanoidRootPart") then
			warn("Character or HumanoidRootPart not found.")
			return 
		end
	
		local rootPart = character.HumanoidRootPart
		local targetPosition = rootPart.CFrame + Vector3.new(0, 5, 0) -- 5 studs above player
	
		local fuelParts = {}
	
		-- 2. Search the workspace for objects named "Fuel"
		for _, item in pairs(workspace:GetDescendants()) do
			if item.Name == "Fuel" then
				table.insert(fuelParts, item)
			end
		end
	
		-- 3. Move the parts if found
		if #fuelParts > 0 then
			for _, fuel in pairs(fuelParts) do
				if fuel:IsA("Model") then
					-- PivotTo works even if the model has no PrimaryPart set
					fuel:PivotTo(targetPosition)
				elseif fuel:IsA("BasePart") then
					-- Move single parts
					fuel.CFrame = targetPosition
				end
			end
	
			-- Success Notification
			game:GetService("StarterGui"):SetCore("SendNotification", {
				Title = "Fuel Moved",
				Text = "Moved " .. #fuelParts .. " Fuel part(s) to your location!",
				Duration = 5
			})
			print("Success: Moved " .. #fuelParts .. " fuel parts.")
		else
			-- Failure Notification
			game:GetService("StarterGui"):SetCore("SendNotification", {
				Title = "No Fuel Found",
				Text = "No Fuel parts were found in the workspace.",
				Duration = 5
			})
			print("Wait: No Fuel items found in workspace.")
		end
	end
	
	-- Connect the button click
	button.MouseButton1Click:Connect(onButtonClicked)
end;
task.spawn(C_d);
-- StarterGui.VodlingGui.VoidlingMainFrame.LocalScript
local function C_e()
local script = G2L["e"];
	local UserInputService = game:GetService("UserInputService")
	
	local gui = script.Parent
	
	local dragging
	local dragInput
	local dragStart
	local startPos
	
	local function update(input)
		local delta = input.Position - dragStart
		-- Updates the position based on the delta (change) in mouse movement
		gui.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
	end
	
	gui.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = gui.Position
	
			-- Observe changes to the input (mouse moving)
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
				end
			end)
		end
	end)
	
	gui.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
			dragInput = input
		end
	end)
	
	UserInputService.InputChanged:Connect(function(input)
		if input == dragInput and dragging then
			update(input)
		end
	end)
end;
task.spawn(C_e);
-- StarterGui.VodlingGui.VoidlingMainFrame.Bring Coal.BringScript
local function C_12()
local script = G2L["12"];
	-- Get references to the button and player
	local button = script.Parent 
	local player = game.Players.LocalPlayer
	
	-- Function to handle the button click
	local function onButtonClicked()
		-- Ensure the player's character exists
		local character = player.Character
		if not character or not character:FindFirstChild("HumanoidRootPart") then
			return 
		end
	
		local targetPos = character.HumanoidRootPart.CFrame + Vector3.new(0, 5, 0)
		local coalParts = {}
	
		-- Search entire workspace for objects named "Coal"
		for _, item in pairs(workspace:GetDescendants()) do
			if item.Name == "Coal" then
				table.insert(coalParts, item)
			end
		end
	
		-- If any "Coal" parts are found, bring them to the player
		if #coalParts > 0 then
			for _, coal in pairs(coalParts) do
				if coal:IsA("Model") then
					-- If it's a model, move it using PivotTo (modern version of SetPrimaryPartCFrame)
					coal:PivotTo(targetPos)
				elseif coal:IsA("BasePart") then
					-- If it's a single part, move its CFrame
					coal.CFrame = targetPos
				end
			end
	
			-- Notification
			game:GetService("StarterGui"):SetCore("SendNotification", {
				Title = "Coal Moved",
				Text = "Moved " .. #coalParts .. " Coal part(s) to your location!",
				Duration = 5
			})
		else
			-- Notification if none found
			game:GetService("StarterGui"):SetCore("SendNotification", {
				Title = "No Coal Found",
				Text = "No Coal parts were found in the workspace.",
				Duration = 5
			})
		end
	end
	
	-- Connect the button click
	button.MouseButton1Click:Connect(onButtonClicked)
	
end;
task.spawn(C_12);

return G2L["1"], require;
