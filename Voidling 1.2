local function C_6()
local script = G2L["6"];
	local bringButton = script.Parent
	
	-- Path: BringButton -> ScrollingFrame -> Frame
	local mainFrame = bringButton.Parent.Parent
	
	-- Path: Frame -> ScreenGui (The root of the UI)
	local voidlingGui = mainFrame.Parent
	
	-- Access the VoidlingMainFrame and the labels
	local voidlingMainFrame = voidlingGui:WaitForChild("VoidlingMainFrame")
	local textToHide = voidlingMainFrame:WaitForChild("Info")
	local textToShow = voidlingMainFrame:WaitForChild("Type of Bring:Fuel") -- The text you want to show
	local textTypeScrap = voidlingMainFrame:WaitForChild("Bring Type of Scrap") -- The text you want to hide
	
	-- Reference the buttons
	local bringFuelButton = mainFrame:WaitForChild("Bring Fuel")
	local bringCoalButton = mainFrame:WaitForChild("Bring Coal")
	local bringAllScrapsButton = mainFrame:WaitForChild("Bring All Scraps")
	
	bringButton.MouseButton1Click:Connect(function()
		-- Check if "Bring All Scraps" is currently visible
		if bringAllScrapsButton.Visible == true or textTypeScrap.Visible == true then
	
			-- 1. Hide the "Bring All Scraps" layout items
			bringAllScrapsButton.Visible = false
			textTypeScrap.Visible = false
			textToHide.Visible = false -- Make sure original info is hidden
	
			-- 2. Show the "Fuel/Coal" layout items
			bringFuelButton.Visible = true
			bringCoalButton.Visible = true
			textToShow.Visible = true
	
		else
			-- If it wasn't visible, just ensure the Fuel/Coal layout shows up anyway
			bringFuelButton.Visible = true
			bringCoalButton.Visible = true
			textToShow.Visible = true
	
			-- Ensure the others stay hidden
			bringAllScrapsButton.Visible = false
			textTypeScrap.Visible = false
			textToHide.Visible = false
		end
	end)
end;
