local function C_19()
local script = G2L["19"];
	-- Get references to the button and player
	local button = script.Parent 
	local player = game.Players.LocalPlayer
	
	-- The list of item names to look for
	local targetNames = {
		"Bolt",
		"Sheet Metal",
		"Broken Fan",
		"Old Radio",
		"Broken Microwave",
		"Tyre",
		"Old Car Engine",
		"Washing Machine",
		"UFO Junk / Components",
		"Metal Chair",
		"Cultist Experiment / Prototype",
		"UFO Scrap"
	}
	
	-- Function to handle the button click
	local function onButtonClicked()
		-- 1. Safety Check
		local character = player.Character
		if not character or not character:FindFirstChild("HumanoidRootPart") then
			warn("Character or HumanoidRootPart not found.")
			return 
		end
	
		local rootPart = character.HumanoidRootPart
		-- Position items slightly in front and above the player
		local targetPosition = rootPart.CFrame * CFrame.new(0, 5, -2) 
	
		local itemsFound = {}
	
		-- 2. Search the workspace for objects in the list
		for _, item in pairs(workspace:GetDescendants()) do
			-- Check if the item's name is in our targetNames list
			if table.find(targetNames, item.Name) then
				table.insert(itemsFound, item)
			end
		end
	
		-- 3. Move the parts if found
		if #itemsFound > 0 then
			for _, item in pairs(itemsFound) do
				if item:IsA("Model") then
					-- Move models using PivotTo
					item:PivotTo(targetPosition)
				elseif item:IsA("BasePart") then
					-- Move single parts
					item.CFrame = targetPosition
				end
			end
	
			-- Success Notification
			game:GetService("StarterGui"):SetCore("SendNotification", {
				Title = "Items Brought",
				Text = "Successfully brought " .. #itemsFound .. " items to you!",
				Duration = 5
			})
		else
			-- Failure Notification
			game:GetService("StarterGui"):SetCore("SendNotification", {
				Title = "Items Not Found",
				Text = "None of the scrap items were found in the workspace.",
				Duration = 5
			})
		end
	end
	
	-- Connect the button click
	button.MouseButton1Click:Connect(onButtonClicked)
end;
task.spawn(C_19);
